# Copy to .env.local for accounts in local development. On GitHub Pages these
# come from the repository's Actions secrets of the same names.
# Supabase → Project Settings → API: the project URL and the anon (publishable) key.
# Both are safe in the browser; row level security keeps each account's data private.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
